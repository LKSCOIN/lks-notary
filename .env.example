# --- Nodo LKSCOIN -------------------------------------------------------
# Il nodo deve avere fallbackfee: con la mempool quasi sempre vuota la stima
# automatica delle fee fallisce e fundrawtransaction restituisce
# "Fee estimation failed", bloccando il batcher.
LKS_RPC_URL=http://127.0.0.1:3344
LKS_RPC_USER=lksrpc
LKS_RPC_PASSWORD=cambiami

# Wallet dedicato sul nodo, creato con:
#   lks-cli createwallet "notary" false false "" false true
# Lascia vuoto solo se il notary usa il wallet predefinito. Sul nodo del mining
# NON lasciarlo vuoto: il wallet predefinito e' quello dei pagamenti del pool.
LKS_RPC_WALLET=notary

# Etichetta dell'indirizzo che tiene i fondi operativi.
LKS_WALLET_LABEL=notary-ops

# Tariffa in LKS/kB, sempre esplicita. Una transazione di batch pesa ~240 byte,
# quindi ~0,000024 LKS: a 144 batch al giorno sono circa 0,10 LKS al mese.
LKS_FEE_RATE=0.0001

# --- Database -----------------------------------------------------------
# MariaDB, con l'utente applicativo (SELECT/INSERT/UPDATE su lks_notary).
DATABASE_URL=mysql+pymysql://notary:cambiami@127.0.0.1:3306/lks_notary

# --- Batching -----------------------------------------------------------
# Un batch ogni 10 minuti: circa 4 blocchi LKSCOIN, abbastanza da aggregare
# senza far attendere troppo chi ha appena notarizzato.
BATCH_INTERVAL_SECONDS=600
BATCH_MAX_LEAVES=4096

# Public base URL, used to build the verify_url returned in every receipt.
PUBLIC_BASE_URL=https://notary.lkschain.io

# --- Anonymous tier -----------------------------------------------------
# Aggregation means volume costs one transaction per window regardless, so the
# cap is about abuse and database growth, not the fee balance.
ANON_ENABLED=true
ANON_DAILY_LIMIT=20
# Any random string. Changing it resets every counter.
ANON_IP_SALT=changeme

# --- Self-service keys: SMTP -------------------------------------------
# Not the website's lks-mail service: that one fixes the recipient in its own
# config so it cannot be used as an open relay, and confirmation links have to
# reach the address the visitor typed. Same mailbox credentials are fine --
# they are in /etc/lks-mail/config.json on the web host.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=noreply@lkschain.io
SMTP_PASSWORD=changeme
MAIL_FROM=noreply@lkschain.io
MAIL_FROM_NAME=LKS Notary
KEY_REQUEST_TTL_HOURS=24
KEY_REQUESTS_PER_DAY=5
