[Unit]
Description=LKS Notary worker (batcher + watcher)
After=network-online.target mariadb.service lksd.service
Wants=network-online.target

[Service]
Type=simple
User=notary
Group=notary
WorkingDirectory=/opt/lks-notary
EnvironmentFile=/opt/lks-notary/.env
ExecStart=/opt/lks-notary/.venv/bin/python -m lks_notary.service
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# OpenTimestamps keeps its calendar cache under HOME
Environment=HOME=/opt/lks-notary/var
ReadWritePaths=/opt/lks-notary/var

[Install]
WantedBy=multi-user.target
